<Window x:Class="PcAudioRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Audio Recorder" Height="660" Width="560"
        MinHeight="620" MinWidth="520"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Window.Resources>
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C73652"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E94560"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A3E"/>
                                <Setter Property="BorderBrush" Value="#444"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#A0C4FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16213E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TopmostToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#A0C4FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E94560"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E94560"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <ToggleButton x:Name="TopmostToggle" DockPanel.Dock="Right"
                          Style="{StaticResource TopmostToggleStyle}"
                          Content="📌 最前面"
                          VerticalAlignment="Center"
                          ToolTip="ウィンドウを常に最前面に表示します"
                          Checked="TopmostToggle_Changed"
                          Unchecked="TopmostToggle_Changed"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" Fill="#E94560" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="PC Audio Recorder" FontSize="22" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#16213E" CornerRadius="10" Padding="15,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="録音時間" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="36" FontWeight="Bold"
                           Foreground="White" FontFamily="Consolas" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#16213E" CornerRadius="10" Padding="15,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="音量レベル" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                <ProgressBar x:Name="VolumeBar" Height="14" Value="0" Maximum="1"
                             Background="#0F3460" Foreground="#E94560"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="録音対象" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DeviceCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="DeviceCombo_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="形式" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="FormatCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                      SelectionChanged="FormatCombo_SelectionChanged">
                <ComboBoxItem Content="WAV (無圧縮)" Tag="WAV"/>
                <ComboBoxItem Content="MP3 128kbps" Tag="MP3_128"/>
                <ComboBoxItem Content="MP3 192kbps" Tag="MP3_192"/>
                <ComboBoxItem Content="MP3 320kbps" Tag="MP3_320"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="保存先" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="OutputDirText" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                     IsReadOnly="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="変更" Style="{StaticResource SubButtonStyle}"
                    x:Name="BrowseButton" Click="BrowseButton_Click"/>
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ファイル名" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="FileNameText" Grid.Column="1" Style="{StaticResource DarkTextBox}"/>
        </Grid>

        <Grid Grid.Row="7" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RecordButton" Grid.Column="0" Content="録音開始"
                    Style="{StaticResource RecordButtonStyle}"
                    Click="RecordButton_Click" Height="46"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="停止"
                    Style="{StaticResource StopButtonStyle}"
                    Click="StopButton_Click" Height="46" IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#16213E" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <TextBlock x:Name="StatusText" Text="待機中" Foreground="#AAA" FontSize="12"
                           TextWrapping="Wrap" FontFamily="Segoe UI"/>
            </Border>
            <Border Grid.Row="1" Background="#111827" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="履歴" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                    <ListBox x:Name="LogList" Background="#111827" Foreground="#D8DEE9"
                             BorderThickness="0" FontSize="11" FontFamily="Consolas"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
