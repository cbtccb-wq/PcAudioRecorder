<Window x:Class="PcAudioRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC再生音録音ソフト" Height="520" Width="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">

    <Window.Resources>
        <!-- ボタンスタイル：録音開始 -->
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C73652"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555"/>
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ボタンスタイル：停止 -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E94560"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#2A2A3E"/>
                                <Setter Property="BorderBrush" Value="#444"/>
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- サブボタンスタイル -->
        <Style x:Key="SubButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#A0C4FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16213E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- テキストボックス -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- コンボボックス -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Ellipse Width="12" Height="12" Fill="#E94560" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="PC Audio Recorder" FontSize="22" FontWeight="Bold"
                       Foreground="White" FontFamily="Segoe UI"/>
        </StackPanel>

        <!-- 録音時間 -->
        <Border Grid.Row="1" Background="#16213E" CornerRadius="10" Padding="15,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="録音時間" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="36" FontWeight="Bold"
                           Foreground="White" FontFamily="Consolas" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 音量レベル -->
        <Border Grid.Row="2" Background="#16213E" CornerRadius="10" Padding="15,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="音量レベル" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                <ProgressBar x:Name="VolumeBar" Height="14" Value="0" Maximum="1"
                             Background="#0F3460" Foreground="#E94560"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 保存形式 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="形式:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
            <ComboBox x:Name="FormatCombo" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                      SelectionChanged="FormatCombo_SelectionChanged">
                <ComboBoxItem Content="WAV (無圧縮)" Tag="WAV"/>
                <ComboBoxItem Content="MP3 128kbps" Tag="MP3_128"/>
                <ComboBoxItem Content="MP3 192kbps" Tag="MP3_192"/>
                <ComboBoxItem Content="MP3 320kbps" Tag="MP3_320"/>
            </ComboBox>
        </Grid>

        <!-- 保存先 -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="保存先:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
            <TextBox x:Name="OutputDirText" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                     IsReadOnly="True" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="変更" Style="{StaticResource SubButtonStyle}"
                    x:Name="BrowseButton" Click="BrowseButton_Click"/>
        </Grid>

        <!-- ファイル名 -->
        <Grid Grid.Row="5" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ファイル名:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
            <TextBox x:Name="FileNameText" Grid.Column="1" Style="{StaticResource DarkTextBox}"/>
        </Grid>

        <!-- ボタン -->
        <Grid Grid.Row="6" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RecordButton" Grid.Column="0" Content="⏺  録音開始"
                    Style="{StaticResource RecordButtonStyle}"
                    Click="RecordButton_Click" Height="46"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="⏹  停止"
                    Style="{StaticResource StopButtonStyle}"
                    Click="StopButton_Click" Height="46" IsEnabled="False"/>
        </Grid>

        <!-- ステータス -->
        <Border Grid.Row="7" Background="#16213E" CornerRadius="8" Padding="12,8" VerticalAlignment="Top">
            <TextBlock x:Name="StatusText" Text="待機中" Foreground="#AAA" FontSize="12"
                       TextWrapping="Wrap" FontFamily="Segoe UI"/>
        </Border>
    </Grid>
</Window>
